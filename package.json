{
  "name": "ctnr-optimizer",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "app": "electron .",
    "dev": "next dev -H 0.0.0.0 -p 4000",
    "clean": "powershell -Command \"Remove-Item -Path .next -Recurse -Force -ErrorAction SilentlyContinue\"",
    "dev:clean": "npm run clean && npm run dev",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start",
    "lint": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next lint",
    "electron:build": "electron-builder"
  },
  "build": {
    "appId": "com.ctnr.server",
    "productName": "CTNR Server",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "tray-icon.png",
      "public/**/*",
      "!node_modules"
    ],
    "asar": true,
    "win": {
      "target": "portable",
      "icon": "icon.png"
    }
  },
  "dependencies": {
    "@react-three/drei": "latest",
    "@react-three/fiber": "latest",
    "@types/bcryptjs": "^2.4.6",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "latest",
    "dotenv": "^17.3.1",
    "exif-parser": "^0.1.12",
    "framer-motion": "latest",
    "googleapis": "^173.0.0",
    "heic-convert": "^2.1.0",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "lucide-react": "latest",
    "next": "latest",
    "pg": "^8.11.3",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "^0.35.3",
    "tailwind-merge": "latest",
    "three": "latest",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/archiver": "^8.0.0",
    "@types/node": "latest",
    "@types/pg": "^8.11.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "latest",
    "autoprefixer": "latest",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "postcss": "latest",
    "tailwindcss": "latest",
    "tsx": "^4.23.0",
    "typescript": "latest"
  }
}
